# ── Copia este archivo como .env.local (no se sube a GitHub) ──

# Llave de Gemini (la nueva, restringida por dominio)
VITE_GEMINI_API_KEY=pon_aqui_tu_llave

# Sentry (opcional). Si lo dejas vacío, el monitoreo queda apagado.
VITE_SENTRY_DSN=

# ── App Check ─────────────────────────────────────────────────
# Llave de SITIO de Fraud Defense (antes reCAPTCHA Enterprise). Es
# pública y está hecha para ir a la vista en el navegador; no hay
# llave secreta que custodiar. Sin ella App Check queda apagado y todo
# sigue funcionando; con ella, las llamadas al servidor llevan su
# distintivo.
#
# NO sirve una llave de reCAPTCHA Classic: Google dejó de permitir
# llaves nuevas de esas en 2024, y el proveedor es otro.
VITE_RECAPTCHA_KEY=

# Para probar en local sin dominio registrado: el token de depuración
# que imprime la consola del navegador, registrado una vez en Firebase.
# VITE_APPCHECK_DEBUG=

# ── Backend ───────────────────────────────────────────────────
# "servidor" = la cadena la escriben las Cloud Functions (producción).
# Vacío o cualquier otra cosa = modo local, la cadena se escribe desde
# el navegador, como antes. Sólo para probar sin funciones desplegadas.
VITE_BACKEND=servidor
VITE_FUNCTIONS_REGION=us-central1

# ── Proyecto de DESARROLLO ────────────────────────────────────
# Estas van en un archivo aparte: .env.development.local
# Sólo aplican con `npm run dev`; el sitio en Render sigue en producción.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
